{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:locale(en|el)/eurovision-quiz",
      "destination": "/:locale/eurovision-trivia",
      "permanent": true
    },
    {
      "source": "/:locale(en|el)/host-eurovision-party",
      "destination": "/:locale/eurovision-party",
      "permanent": true
    },
    {
      "source": "/eurovision-quiz",
      "destination": "/en/eurovision-trivia",
      "permanent": true
    },
    {
      "source": "/host-eurovision-party",
      "destination": "/en/eurovision-party",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?<l>.*\\bel\\b.*)"
        }
      ],
      "destination": "/el",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/:slug(how-to-play|eurovision-night|eurovision-games|eurovision-party|eurovision-trivia|eurovision-predictions|eurovision-2026-predictions|faq|rules|scoring|about|privacy|terms|duels|dashboard|cookies|winners)",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "(?<l>.*\\bel\\b.*)"
        }
      ],
      "destination": "/el/:slug",
      "permanent": true
    },
    {
      "source": "/:slug(how-to-play|eurovision-night|eurovision-games|eurovision-party|eurovision-trivia|eurovision-predictions|eurovision-2026-predictions|faq|rules|scoring|about|privacy|terms|duels|dashboard|cookies|winners)",
      "destination": "/en/:slug",
      "permanent": true
    },
    {
      "source": "/:slug(online-games|mobile-games)",
      "destination": "/en/eurovision-games",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!en/|el/|content/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://ameneqrrfdhntfzvchnn.supabase.co wss://ameneqrrfdhntfzvchnn.supabase.co; img-src 'self' data: https:; font-src 'self'; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
